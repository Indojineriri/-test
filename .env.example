# Anthropic API key (required). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model: claude-opus-4-7 (default) or claude-sonnet-4-6
ANTHROPIC_MODEL=claude-opus-4-7

# Google Cloud Storage destination for uploaded decks (optional).
# Leave empty to skip GCS upload during local development.
GCS_BUCKET=
GCS_PREFIX=meeting-decks

# Authenticate to GCS with Application Default Credentials, e.g.:
#   gcloud auth application-default login
# or point to a service-account key:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Long edge (px) for rasterised slides sent to Claude (lower = cheaper).
IMAGE_LONG_EDGE=1600
